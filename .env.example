# Docker log rotation (json-file driver)

# Maximum size of a single log file
MAX_LOG_FILE_SIZE=10m
# Number of log files to keep
MAX_LOG_FILE_COUNT=3


# PostgreSQL database for LiteLLM (stores usage, keys, audit logs)

# Database version
POSTGRES_VERSION=18.6
# Database name
POSTGRES_DB=litellm
# Database user
POSTGRES_USER=litellm
# Database password (change in production; avoid @ : / characters)
POSTGRES_PASSWORD=pgpass4litellm


# LiteLLM proxy

# LiteLLM version
LITELLM_VERSION=latest
# Host/interface the proxy port binds to on the host (127.0.0.1 = localhost only)
LITELLM_BIND_ADDRESS=127.0.0.1
# Port exposed on the host (container always listens on 4000 internally)
LITELLM_PORT=4000
# Master key to authenticate requests to the proxy (change in production, required)
LITELLM_MASTER_KEY=admin
# LiteLLM log level: DEBUG, INFO, WARNING, ERROR
LITELLM_LOG=INFO
